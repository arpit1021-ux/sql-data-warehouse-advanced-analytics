model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["_Measures","fact_sales","dim_customers","dim_products","dim_date","RepoFolder"]

ref table _Measures
ref table fact_sales
ref table dim_customers
ref table dim_products
ref table dim_date

ref role 'Country Manager - US'

ref cultureInfo en-US

